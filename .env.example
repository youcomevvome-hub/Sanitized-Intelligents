# Sanitizer configuration

# Device: "cpu", "cuda", or "auto"
SANITIZER_DEVICE=auto

# Model cache directory
SANITIZER_MODEL_DIR=./models

# Face detection backend: "yolo", "retinaface", or "ensemble"
SANITIZER_FACE_BACKEND=ensemble

# OCR backend: "easyocr", "paddleocr", or "ensemble"
SANITIZER_OCR_BACKEND=easyocr

# OCR languages (comma-separated ISO codes)
SANITIZER_OCR_LANGS=en

# Blur kernel size (odd integer). Higher = stronger blur.
SANITIZER_BLUR_KERNEL=51

# Mask mode: "blur", "pixelate", "blackbox"
SANITIZER_MASK_MODE=blur

# API
SANITIZER_API_HOST=0.0.0.0
SANITIZER_API_PORT=8000
SANITIZER_MAX_UPLOAD_MB=200
